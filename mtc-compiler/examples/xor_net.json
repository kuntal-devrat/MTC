{
  "name": "xor_net",
  "precision": "int16",
  "input_range": [0.0, 1.0],
  "target_range": [0.0, 1.0],
  "epochs": 1000,
  "seed": 2,
  "layers": [
    {
      "type": "dense",
      "in_features": 2,
      "out_features": 4
    },
    {
      "type": "relu"
    },
    {
      "type": "dense",
      "in_features": 4,
      "out_features": 1
    },
    {
      "type": "sigmoid"
    }
  ],
  "loss": "mse",
  "optimizer": {
    "type": "sgd",
    "learning_rate": 0.1
  },
  "training_data": [
    {"input": [0.0, 0.0], "target": [0.0]},
    {"input": [0.0, 1.0], "target": [1.0]},
    {"input": [1.0, 0.0], "target": [1.0]},
    {"input": [1.0, 1.0], "target": [0.0]}
  ]
}