{
  "name": "sensor_drift_net",
  "precision": "int16",
  "input_range": [0.0, 1.0],
  "target_range": [0.0, 1.0],
  "epochs": 250,
  "seed": 11,
  "layers": [
    { "type": "dense", "in_features": 4, "out_features": 16 },
    { "type": "relu" },
    { "type": "dense", "in_features": 16, "out_features": 8 },
    { "type": "relu" },
    { "type": "dense", "in_features": 8, "out_features": 1 },
    { "type": "sigmoid" }
  ],
  "loss": "mse",
  "optimizer": { "type": "sgd", "learning_rate": 0.01 },
  "training_data": [
    {"input": [0.0, 0.0, 0.0, 0.0], "target": [0.0]},
    {"input": [1.0, 0.0, 0.0, 0.0], "target": [0.25]},
    {"input": [0.0, 1.0, 0.0, 0.0], "target": [0.5]},
    {"input": [0.0, 0.0, 1.0, 0.0], "target": [0.75]},
    {"input": [0.0, 0.0, 0.0, 1.0], "target": [1.0]},
    {"input": [1.0, 1.0, 0.0, 0.0], "target": [0.4]},
    {"input": [0.0, 1.0, 1.0, 0.0], "target": [0.6]},
    {"input": [0.0, 0.0, 1.0, 1.0], "target": [0.9]}
  ]
}
