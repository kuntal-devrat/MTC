{
  "version": 1,
  "author": "MTC Project Team (GL Bajaj Group of Institutions)",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "board-ssd1306",
      "id": "oled",
      "top": -140,
      "left": 40,
      "attrs": { "i2cAddress": "0x3c" }
    },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": 70,
      "left": 180,
      "attrs": { "color": "limegreen", "label": "TRAIN_ACTIVE" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 110,
      "left": 180,
      "attrs": { "value": "220" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "oled:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "oled:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "oled:SCL", "esp:22", "yellow", [ "v0" ] ],
    [ "oled:SDA", "esp:21", "blue", [ "v0" ] ],
    [ "esp:2", "led1:A", "green", [ "v0" ] ],
    [ "led1:C", "r1:1", "black", [ "v0" ] ],
    [ "r1:2", "esp:GND.2", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
